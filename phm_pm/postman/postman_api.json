{
  "info": {
    "name": "My API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost"
    }
  ],
  "item": [
    {
      "name": "post_user",
      "request": {
        "method": "POST",
        "description": " # post_user\r\nAllows you to create a user!\r\n",
        "url": {
          "raw": "{{base_url}}/post_user",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "post_user"
          ]
        }
      }
    }
  ]
}